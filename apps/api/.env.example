# Neon PostgreSQL
DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.neon.tech/emplobo?sslmode=require"
DIRECT_URL="postgresql://user:pass@ep-xxx.neon.tech/emplobo?sslmode=require"

# Clerk (server-side verification only — same secret as web)
CLERK_SECRET_KEY="sk_test_xxx"
# Publishable key is required by @clerk/backend to parse the instance id.
CLERK_PUBLISHABLE_KEY="pk_test_xxx"

# Svix signing secret from Clerk Dashboard → Webhooks
CLERK_WEBHOOK_SECRET="whsec_xxx"

# AI gateway — OpenAI-compatible Chat Completions proxy (server-side only, never expose to apps/web)
AI_API_KEY="sk-hc-v1-xxx"
# Base URL of the OpenAI-compatible endpoint (defaults to Hack Club AI proxy)
AI_BASE_URL="https://ai.hackclub.com/proxy/v1"
# Model slug served by the gateway, e.g. "openai/gpt-oss-safeguard-20b"
# (default), or any model the proxy exposes.
AI_MODEL="openai/gpt-oss-safeguard-20b"
# Reasoning effort for reasoning-capable models (gpt-oss, qwen3). "minimal"
# keeps replies complete, fast, and free of leaked chain-of-thought. Set
# "low"/"medium"/"high" for deeper reasoning, or empty for non-reasoning models.
AI_REASONING_EFFORT="minimal"

# Backup AI gateway (optional, all three together or none) — last-resort
# failover used only after the primary exhausts every transient retry
AI_BACKUP_BASE_URL="https://backup-gateway.example.com/v1"
AI_BACKUP_API_KEY="sk-backup-xxx"
AI_BACKUP_MODEL="deepseek-v4-flash"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://xxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxx"

# CORS allowlist — must match the deployed web origin exactly
WEB_APP_ORIGIN="http://localhost:3000"

PORT="4000"
NODE_ENV="development"
